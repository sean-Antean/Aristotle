# Copy to .env.local for local dev; set the same two vars in Vercel project settings.
# Server-only (never exposed to the browser). The dashboard reads Supabase with the
# service role key from a SERVER component, so the anon key is not used.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your service role key...
